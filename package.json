{
  "name": "tienda-zapatillas",
  "version": "1.0.0",
  "description": "Sistema web de predicción y reporte de ventas de una tienda de zapatillas (Express + MySQL + TensorFlow.js + Chart.js)",
  "main": "servidor/servidor.js",
  "scripts": {
    "start": "node servidor/servidor.js",
    "dev": "node --watch servidor/servidor.js",
    "db:setup": "node herramientas/configurar-bd.js",
    "seed:generate": "node herramientas/generar-datos-ejemplo.js",
    "test": "node --test --test-concurrency=1 pruebas/api.prueba.js pruebas/autenticacion.prueba.js pruebas/modelo.prueba.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tensorflow/tfjs": "^4.22.0",
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6"
  }
}
