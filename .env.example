# Copia este archivo como .env y ajusta los valores:
#   Windows (cmd):  copy .env.example .env
#   Linux/macOS:    cp .env.example .env
# NUNCA subas el archivo .env a Git.

PORT=3000

# Conexión a MySQL (usa un usuario con permisos solo sobre esta base, no root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tienda_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=tienda_zapatillas

# Solo para `npm run db:setup` (crear base/tablas/datos): usuario con permisos de administración
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Base de datos EXCLUSIVA para pruebas (el nombre debe terminar en _test).
# Las pruebas la recrean desde cero; nunca apuntan a la base real.
DB_NAME_TEST=tienda_zapatillas_test

# Carpeta donde se guarda el modelo entrenado (opcional)
# MODEL_DIR=./modelos

# Orígenes CORS permitidos, separados por coma (opcional; vacío = solo mismo origen)
# CORS_ORIGINS=http://localhost:5173

# Solo para Docker Compose: contraseña de root del contenedor MySQL
# DB_ROOT_PASSWORD=cambia_esta_clave_root

# Administrador inicial (se crea SOLO si la tabla usuarios está vacía al arrancar).
# Si no defines ADMIN_PASSWORD se genera una al azar y se imprime en la consola.
ADMIN_EMAIL=admin@footwear.local
ADMIN_PASSWORD=Admin1234!
# Horas de duración de la sesión y cookie Secure (poner true si usas HTTPS)
# SESSION_HOURS=8
# COOKIE_SECURE=false
